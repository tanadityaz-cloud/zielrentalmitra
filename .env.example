# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# ====================================================================
# POSTGRESQL DATABASE CONFIGURATION (SHARED WITH ADMIN PANEL)
# Masukkan detail koneksi database PostgreSQL Anda di bawah ini
# agar Panel Mitra dan Panel Admin terhubung langsung secara real-time.
# ====================================================================

# Opsi 1: Connection String Lengkap (Contoh: Supabase / Neon / Render / Cloud SQL)
# DATABASE_URL="postgresql://postgres:yourpassword@db.example.com:5432/zielrental"
DATABASE_URL=

# Opsi 2: Konfigurasi Parameter Terpisah
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=require

# ====================================================================
# ADMIN PANEL API & WEBHOOK CONFIGURATION (OPTIONAL)
# ====================================================================
ADMIN_API_URL=
ADMIN_API_KEY=
